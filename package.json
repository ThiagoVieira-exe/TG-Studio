{
  "name": "tg-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Sistema de montagem e preparação de artes para impressão",
  "homepage": "https://github.com/SEU-USUARIO/tg-studio",
  "author": {
    "name": "TG Studio",
    "email": "noreply@tgstudio.local"
  },
  "desktopName": "tg-studio",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:electron": "tsc -b && vite build --base ./",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "electron:dev": "npm run build:electron && electron .",
    "dist:win": "npm run build:electron && electron-builder --win",
    "dist:linux": "npm run build:electron && electron-builder --linux",
    "dist": "npm run build:electron && electron-builder"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.67.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^39.1.2",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "com.tgstudio.app",
    "productName": "TG Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "category": "Graphics",
      "maintainer": "TG Studio <noreply@tgstudio.local>"
    }
  }
}
